      "name": "Translate text",
      "description": "Translate a piece of text to the requested target language using Google Translate. Call this when the user asks to translate text, asks what something means in another language, or writes content that needs to be rendered in another language. Returns the translation and, when source was 'auto', the detected source language.",
      "parameters": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "The text to translate."
          },
          "to": {
            "type": "string",
            "description": "Target language ISO code (e.g. 'es', 'fr', 'ja')."
          },
          "from": {
            "type": "string",
            "description": "Optional source language ISO code. Omit or pass 'auto' to let Google detect."
          }
        },
        "required": [
          "text",
          "to"
        ]
      }
    }
